.PHONY: mock_service

HAL_DIR ?= $(CURDIR)

PLANECONTROL_SONAME := planecontrolaidl

MOCK_SERVICE_BIN := PlaneControlService
PLANECONTROL_LIB := lib$(PLANECONTROL_SONAME).so

BUILD_DIR ?= $(HAL_DIR)/build

AIDL_GEN_DIR ?= $(BUILD_DIR)/planecontrol_gen/current

MOCK_SERVICE_DIR ?= $(HAL_DIR)/service/src

PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/PropertyValue.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/PropertyKVPair.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/PlaneType.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/AspectRatio.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/Property.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/SourceType.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/SourcePlaneMapping.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/IPlaneControl.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/IPlaneControlListener.cpp
PLANECONTROL_AIDL_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/planecontrol/Capabilities.cpp

MOCK_SERVICE_BIN_SRC := $(MOCK_SERVICE_DIR)/PlaneControlService.cpp
MOCK_SERVICE_BIN_SRC += $(MOCK_SERVICE_DIR)/PlaneControl.cpp


MOCK_SERVICE_INC_FLAGS := -I$(AIDL_GEN_DIR)/h
MOCK_SERVICE_INC_FLAGS += -I$(BUILD_DIR)/usr/include
MOCK_SERVICE_INC_FLAGS += -I$(MOCK_SERVICE_DIR)

MOCK_SERVICE_LD_LIBS := -lbinder -lutils

MOCK_SERVICE_LDFLAGS := -L$(BUILD_DIR)/usr/lib
MOCK_SERVICE_LDFLAGS += -Wl,-rpath-link=$(BUILD_DIR)/usr/lib

MOCK_SERVICE_CFLAGS := -Wall -Wextra -std=c++17 -ggdb

mock_service: $(MOCK_SERVICE_BIN) $(PLANECONTROL_LIB)

$(PLANECONTROL_LIB): $(PLANECONTROL_AIDL_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $^ -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $(PLANECONTROL_LIB) $(BUILD_DIR)/usr/lib

$(MOCK_SERVICE_BIN): $(PLANECONTROL_LIB)
$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_BIN_SRC:%.cpp=%.o)
	g++ $(MOCK_SERVICE_LDFLAGS) \
		$(MOCK_SERVICE_BIN_SRC:%.cpp=%.o) -o $@ \
		$(MOCK_SERVICE_LD_LIBS) \
		-lpthread \
		-l$(PLANECONTROL_SONAME)
	install $(MOCK_SERVICE_BIN) $(BUILD_DIR)/usr/bin

# TODO: to be compile out of source tree
%.o: %.cpp
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -fPIC -c $< -o $@
